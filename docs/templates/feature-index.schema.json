{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Feature Index",
  "type": "object",
  "required": [
    "schema_version",
    "features"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "depends_on",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^feat-[A-Za-z0-9._-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "detail": {
            "type": "string",
            "pattern": "^features/.+\\.md$"
          },
          "specs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
