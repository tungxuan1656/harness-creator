{
  "name": "harness-slim",
  "description": "Harness engineering for AI coding agents — five subsystems, feature_index.json state (id, title, status, priority, depends_on), memory persistence, session continuity, verification workflows, scope control, lifecycle management.",
  "license": "MIT",
  "author": "tungxuan1656",
  "publisher": "tungxuan1656",
  "repository": "https://github.com/tungxuan1656/harness-slim",
  "languages": ["en", "zh"],
  "compatibility": {
    "agents": [
      "claude-code",
      "codex-cli",
      "cursor",
      "windsurf",
      "generic"
    ]
  },
  "entryPoint": "SKILL.md",
  "references": [
    "references/memory-persistence-pattern.md",
    "references/context-engineering-pattern.md",
    "references/multi-agent-pattern.md",
    "references/repository-knowledge-architecture.md",
    "references/gotchas.md"
  ],
  "triggers": [
    "harness engineering",
    "agent reliability",
    "session continuity",
    "memory persistence",
    "verification workflow",
    "scope control",
    "lifecycle management",
    "AGENTS.md",
    "CLAUDE.md",
    "feature tracking",
    "session handoff",
    "multi-agent coordination",
    "context engineering",
    "tool safety",
    "permission pipeline"
  ],
  "bundled": {
    "scripts": [
      "scripts/create-harness.mjs",
      "scripts/validate-harness.mjs",
      "scripts/render-assessment-html.mjs",
      "scripts/run-benchmark.mjs",
      "scripts/check-state.sh",
      "scripts/lib/harness-utils.mjs"
    ],
    "assets": [],
    "templates": [
      "templates/agents.md",
      "templates/detailed-plan.md",
      "templates/feature_index.json",
      "templates/features/feat-001.md",
      "templates/init.sh",
      "templates/progress.md"
    ]
  }
}
